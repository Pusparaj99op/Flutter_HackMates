# EcoQuest AR Carbon Tracker - Git Ignore
# Project Type: Dreamflow Visual Builder (No-Code Platform)

# Note: This is a Dreamflow project. There are no traditional source files.
# All implementation is done through Dreamflow's web interface.
# This .gitignore only covers documentation and configuration files.

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment Variables (if any local config exists)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase Config (sensitive data)
google-services.json
firebase-config.json
.firebase/
.firebaserc

# Build Artifacts (if APK downloaded locally)
*.apk
*.aab
build/
dist/

# Temporary Files
tmp/
temp/
*.tmp
*.cache

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Documentation Drafts (keep published docs)
drafts/
notes/
scratch/

# Asset Originals (keep optimized versions)
assets-source/
*.psd
*.ai
*.sketch

# Dependencies (if any local tools used)
node_modules/
vendor/

# Test Data
test-data/
mock-data/

